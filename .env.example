# Local settings: copy to .env (ignored by git) and fill in. Scripts read .env at startup (tools/common.py);
# variables already set in the environment take precedence. Paths are relative to the repo root or absolute.

# Proposal detector (YOLO, private weights, never commit them): proposed boxes for FRED (--step yolo) and DVIDS,
# background filter. Expected classes and their mapping to ours: DETECTOR_CLASSES in tools/common.py.
DETECTOR_PESI=

# SAM 2 for the Svanström and FRED boxes; Ultralytics downloads the weights on first use if the file is missing.
SAM_PESI=data/input/modelli/sam2.1_l.pt

# Local CVAT for label review (if empty: ~/.config/cvat.env)
CVAT_URL=http://localhost:8080
CVAT_USER=
CVAT_PASS=
