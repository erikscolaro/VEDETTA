# Single plot style: plt.style.use(tools.plots.STYLE).
# Sizes meant for 1:1 printing in the thesis (figure.figsize = text width):
# the fonts stay the ones written here even inside the final PDF.

figure.figsize: 5.9, 3.6
figure.dpi: 120
figure.constrained_layout.use: True
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.03
pdf.fonttype: 42
ps.fonttype: 42

font.size: 9
axes.titlesize: 10
axes.labelsize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False

axes.spines.top: False
axes.spines.right: False
axes.edgecolor: 666666
axes.labelcolor: 333333
xtick.color: 666666
ytick.color: 666666
axes.grid: True
axes.axisbelow: True
grid.color: e5e5e5
grid.linewidth: 0.6

lines.linewidth: 2
lines.markersize: 5
image.cmap: Blues

# validated categorical palette (colorblind-safe on adjacent pairs), in
# fixed order: blue, orange, teal, yellow, magenta, green, purple, red
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '4a3aa7', 'e34948'])
