__pycache__/
*.pyc
.venv/

# dati: solo la struttura; di input e intermediate solo scelte, liste, log e manuale.tar.gz, aggiunti con git add -f
data/*
!data/input/
!data/intermediate/
!data/output/
data/input/*
!data/input/.gitkeep
data/intermediate/*
!data/intermediate/.gitkeep
# output: per ora solo la cartella, finche' non si decide come versionare il dataset (GitHub o Hugging Face)
data/output/*
!data/output/.gitkeep

# pesi dei modelli (.pt): solo la cartella; il detector delle proposte e' privato e non va mai in git
models/*
!models/.gitkeep

# impostazioni e appunti locali
.env
